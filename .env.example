DATABASE_PORT=5433
DATABASE_HOST=localhost
DATABASE_USERNAME=your_username
DATABASE_PASSWORD=your_password
DATABASE_NAME=your_db_name
JWT_SECRET=your_jwt_secret
FRONTEND_BASE_URL=http://localhost:5173
RECOMMENDATION_SERVICE_BASE_URL=http://localhost:8000
RECOMMENDER_INTERNAL_TOKEN=
# Auth cookie attributes — COOKIE_SECURE=true + COOKIE_SAMESITE=None for an
# HTTPS cross-origin SPA; defaults suit same-site / local dev.
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
